# ============================================================
# Apache config for DealHub — serve from this folder (public/)
# ============================================================

Options -Indexes -MultiViews
ServerSignature Off

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Force HTTPS (uncomment once your certificate is installed)
    # RewriteCond %{HTTPS} !=on
    # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Block hidden files (.env, .git …) completely
    RewriteRule (^|/)\.(?!well-known) - [F]

    # Route everything that isn't a real file/dir to index.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [QSA,L]
</IfModule>

# Security headers (also set in PHP — belt & braces)
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header unset X-Powered-By
</IfModule>

# Never let these be fetched directly
<FilesMatch "\.(env|sql|md|log|ini|lock|bak)$">
    Require all denied
</FilesMatch>
