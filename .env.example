# ============================================================
# DealHub environment template — copy to .env and fill values.
# NEVER commit the real .env file.
# ============================================================

APP_NAME="DealHub"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://yourdomain.com
APP_TZ=UTC

# Generate with: php -r "echo bin2hex(random_bytes(32));"
APP_KEY=CHANGE_ME_64_CHAR_RANDOM_STRING

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=dealhub
DB_USER=dealhub_app
DB_PASS=CHANGE_ME_STRONG_DB_PASSWORD

# Set true only behind HTTPS (recommended, keep true in production)
COOKIE_SECURE=true

MAIL_DRIVER=log
MAIL_FROM=no-reply@yourdomain.com
